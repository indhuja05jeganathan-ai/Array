class arr
{
    public static void main(String[] args)
    {
        int arr[] = {10,20,30,50,60};
        int n = arr.length;

        int diff = arr[1] - arr[0];

        for(int i = 1; i < n; i++)
        {
            if(arr[i] - arr[i-1] != diff)
            {
                System.out.println("Missing Number = " + (arr[i-1] + diff));
                break;
            }
        }
    }
}
